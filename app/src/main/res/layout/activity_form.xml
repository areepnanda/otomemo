<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Tambah Catatan Servis"
            android:textSize="20sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/inputVehicle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nama kendaraan (mis. Honda Beat)"
            android:inputType="textCapWords" />

        <EditText
            android:id="@+id/inputPlate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Plat nomor (mis. B 1234 XYZ)"
            android:inputType="textCapCharacters" />

        <EditText
            android:id="@+id/inputDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:hint="Tanggal servis"
            android:inputType="none" />

        <EditText
            android:id="@+id/inputWorkshop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Bengkel (opsional)"
            android:inputType="textCapWords" />

        <EditText
            android:id="@+id/inputItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Item servis (mis. Ganti oli, tune up)"
            android:inputType="textCapSentences" />

        <EditText
            android:id="@+id/inputCost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Biaya (Rp, angka saja)"
            android:inputType="number" />

        <EditText
            android:id="@+id/inputNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:hint="Catatan (opsional)"
            android:inputType="textMultiLine"
            android:minLines="2" />

        <Button
            android:id="@+id/buttonSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/save" />
    </LinearLayout>
</ScrollView>
